  "report_format": "html",
  "coverage_enabled": true,
  "coverage_threshold": 95,
  "log_level": "DEBUG",
  "environment": {
    "use_mock_services": false,
    "external_resources": true,
    "temp_directory": "",
    "database_path": "",
    "network_access": true,
    "elevated_permissions": true
  },
  "security_test_params": {
    "fuzz_test_iterations": 1000,
    "encryption_test_rounds": 100,
    "network_test_ports": [80, 443, 8080, 8443, 22, 21],
    "authentication_test_retries": 20
  }
}