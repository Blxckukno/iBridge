{
  "run_unit_tests": true,
  "run_integration_tests": false,
  "run_security_tests": false,
  "run_performance_tests": false,
  "verbose_output": true,
  "create_test_report": true,
  "open_report_browser": false,
  "test_timeout": 60,
  "parallel_tests": false,
  "cleanup_after_tests": true,
  "retry_failed_tests": 2,
  "fail_fast": true,
  "include_patterns": ["test_firewall.*"],
  "exclude_patterns": [],
  "report_format": "html",
  "coverage_enabled": true,
  "coverage_threshold": 90,
  "log_level": "DEBUG",
  "test_data": {
    "sample_files": {
      "small_file_size": 1024,
      "large_file_size": 1048576,
      "binary_file_size": 10240
    }
  },
  "environment": {
    "use_mock_services": true,
    "external_resources": false,
    "temp_directory": "",
    "database_path": "",
    "network_access": false
  }
}